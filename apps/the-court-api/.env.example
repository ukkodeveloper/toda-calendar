# the-court-api — 로컬/배포 환경변수
# 로컬은 .env.local 또는 .env 로 복사해 채운다.

HOST=0.0.0.0
PORT=8080

# Railway Postgres — 슬라이스 02/05 에서 실연결 (지금은 비워둠, worker-db 소관)
DATABASE_URL=

# Redis — Socket.IO 수평확장 adapter (선택). 비우면 in-memory 단일 replica.
#   설정 시 서버가 @socket.io/redis-adapter 를 동적 부착(교차노드 브로드캐스트).
#   실제 multi-replica 로 스케일할 때만 켠다(코드 이음매는 항상 준비됨).
# 예) REDIS_URL=redis://default:pass@host:6379
REDIS_URL=

# CORS — 정확 오리진(콤마 구분) + Vercel preview 정규식(선택)
# 예) CORS_ORIGINS=https://the-court.vercel.app,http://localhost:3100
CORS_ORIGINS=http://localhost:3100
# 예) ^https://the-court-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_PREVIEW_REGEX=
